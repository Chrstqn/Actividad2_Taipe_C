<div style="padding: 20px; font-family: sans-serif;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h1 style="margin: 0; color: #333;">Inventario de Productos</h1>
        <div>
            <a href="/nuevo" style="background: #28a745; color: white; padding: 10px 15px; border-radius: 5px; text-decoration: none; font-weight: bold; margin-right: 10px;">+ Añadir Producto</a>
            <a href="/logout" style="color: #dc3545; text-decoration: none; font-weight: bold;">Cerrar Sesión</a>
        </div>
    </div>

    <hr style="border: 0; border-top: 1px solid #eee; margin-bottom: 30px;">

    <div style="display: flex; gap: 25px; flex-wrap: wrap; justify-content: flex-start;">
        {{#each productos}}
            <div style="border: 1px solid #ddd; padding: 0; width: 220px; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.05); background: #fff;">
                <!-- Imagen con altura fija para uniformidad -->
                <img src="{{this.imagen}}" alt="{{this.nombre}}" style="width: 100%; height: 180px; object-fit: cover;">
                
                <div style="padding: 15px;">
                    <h3 style="margin: 0 0 10px 0; font-size: 1.2em; color: #333;">{{this.nombre}}</h3>
                    <p style="margin: 0 0 10px 0; color: #28a745; font-weight: bold; font-size: 1.1em;">${{this.precio}}</p>
                    <div style="margin: 0 0 15px 0; font-size: 0.9em; color: #666; height: 60px; overflow-y: auto; padding-right: 5px; border-bottom: 1px solid #f0f0f0;">{{this.descripcion}}
                        <div style="border-top: 1px solid #eee; padding-top: 10px; display: flex; justify-content: space-between;">
                             <a href="/editar/{{this._id}}" style="color: #ffc107; text-decoration: none; font-weight: bold; font-size: 0.9em;">✏️ Editar</a>
                             <a href="/eliminar/{{this._id}}" style="color: #dc3545; text-decoration: none; font-weight: bold; font-size: 0.9em;" onclick="return confirm('¿Estás seguro de eliminar este producto?')">🗑️ Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        {{else}}
            <div style="width: 100%; text-align: center; padding: 50px; background: #f9f9f9; border-radius: 10px; color: #888;">
                <p>No hay productos en el inventario. ¡Empieza añadiendo uno!</p>
            </div>
        {{/each}}
    </div>
</div>