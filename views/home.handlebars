<h1>Inventario de Productos</h1>
<a href="/nuevo">Añadir Nuevo Producto</a>

<hr>

<div style="display: flex; gap: 20px; flex-wrap: wrap;">
    {{#each productos}}
        <div style="border: 1px solid #ccc; padding: 15px; width: 200px;">
            <img src="{{this.imagen}}" alt="{{this.nombre}}" style="width: 100%; height: 150px; object-fit: cover;">
            <h3>{{this.nombre}}</h3>
            <p><strong>Precio:</strong> ${{this.precio}}</p>
            <p>{{this.descripcion}}</p>
        </div>
    {{else}}
        <p>No hay productos en el inventario.</p>
    {{/each}}
<div style="margin-top: 10px;">
    <a href="/editar/{{this._id}}" style="color: orange;">Editar</a> | 
    <a href="/eliminar/{{this._id}}" style="color: red;" onclick="return confirm('¿Seguro?')">Eliminar</a>
</div>